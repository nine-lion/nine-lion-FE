            "description": "추출 신뢰도. **0.7 미만이면 `needs_confirmation=true`**."
          },
          "provider": {
            "type": "string",
            "description": "사용한 추출기 식별자",
            "examples": ["openai:gpt-4o-mini", "heuristic", "heuristic_fallback"]
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "사용자 확인이 필요한 사항. 폴백 발생 시 이유 명시."
          },
          "missing_fields": {
            "type": "array",
            "readOnly": true,
            "items": {"type": "string", "enum": ["exam", "date", "scope", "target"]},
            "description": "비어 있는 4개 항목의 키 배열. FE에서 빨간 칸 표시용."
          },
          "missing_labels": {
            "type": "array",
            "readOnly": true,
            "items": {"type": "string", "enum": ["시험명", "시험일", "출제범위", "목표"]},
            "description": "`missing_fields` 의 한글 라벨 버전."
          },
          "is_complete": {
            "type": "boolean",
            "readOnly": true,
            "description": "4개 항목이 모두 채워졌는지 여부."
          },
          "needs_confirmation": {
            "type": "boolean",
            "readOnly": true,
            "description": "`missing_fields` 가 있거나 `confidence < 0.7` 이면 `true`. FE에서 재질문 UX 트리거."
          }
        }
      },
      "GoalDraftResponse": {
        "type": "object",
        "title": "GoalDraftResponse",
        "description": "텍스트 → 초안 변환 결과 (저장 X)",
        "required": ["transcript", "draft", "reference_date"],
        "properties": {
          "transcript": {"type": "string", "description": "입력으로 받은 텍스트"},
          "draft": {"$ref": "#/components/schemas/GoalDraft"},
          "reference_date": {"type": "string", "format": "date", "description": "상대 날짜 계산에 사용된 기준일"}
        }
      },
      "VoiceGoalResponse": {
        "type": "object",
        "title": "VoiceGoalResponse",
        "description": "음성 → 전사 → 추출 → (저장) 결과를 한 번에 반환",
        "required": ["transcript", "draft", "reference_date", "stt_model"],
        "properties": {
          "transcript": {"type": "string", "description": "STT가 인식한 한국어 텍스트"},
          "draft": {"$ref": "#/components/schemas/GoalDraft"},
          "reference_date": {"type": "string", "format": "date", "description": "상대 날짜 계산에 사용된 기준일"},
          "stt_model": {"type": "string", "description": "사용된 STT 모델명", "example": "gpt-4o-transcribe"},
          "duration": {"type": "number", "format": "float", "nullable": true, "description": "원본 오디오 길이(초). `whisper-1` 만."},
          "saved": {"type": "boolean", "default": false, "description": "`save=true` 이고 4개 항목이 모두 채워져 즉시 저장되었는지"},
          "goal": {
            "nullable": true,
            "description": "저장에 성공한 경우에만 채워지는 목표 객체",
            "oneOf": [
              {"$ref": "#/components/schemas/GoalRead"},
              {"type": "null"}
            ]
          }
        }
      },
      "GoalCreate": {
        "type": "object",
        "title": "GoalCreate",
        "description": "목표 생성 페이로드",
        "required": ["exam", "date", "scope", "target"],
        "properties": {
          "exam": {"type": "string", "minLength": 1, "maxLength": 200, "description": "시험명", "example": "일반기계기사 필기"},
          "date": {"type": "string", "format": "date", "description": "시험일", "example": "2026-09-26"},
          "scope": {"type": "string", "minLength": 1, "maxLength": 2000, "description": "출제범위", "example": "재료역학 · 기계열역학"},
          "target": {"type": "string", "minLength": 1, "maxLength": 2000, "description": "달성 목표", "example": "기출 7개년 2회독"},
          "source": {"type": "string", "enum": ["voice", "manual"], "default": "manual", "description": "입력 출처"},
          "transcript": {"type": "string", "nullable": true, "maxLength": 8000, "description": "원본 전사 텍스트 (음성 입력 시 보존)"}
        }
      },
      "GoalUpdate": {
        "type": "object",
        "title": "GoalUpdate",
        "description": "목표 부분 수정. **전달한 필드만** 반영 (`exclude_unset=True`).",
        "properties": {
          "exam": {"type": "string", "nullable": true, "minLength": 1, "maxLength": 200, "description": "시험명"},
          "date": {"type": "string", "format": "date", "nullable": true, "description": "시험일"},
          "scope": {"type": "string", "nullable": true, "minLength": 1, "maxLength": 2000, "description": "출제범위"},
          "target": {"type": "string", "nullable": true, "minLength": 1, "maxLength": 2000, "description": "달성 목표"}
        }
      },
      "GoalRead": {
        "type": "object",
        "title": "GoalRead",
        "description": "저장된 목표 (응답 전용)",
        "required": ["id", "exam", "date", "scope", "target", "source", "created_at", "updated_at", "d_day"],
        "properties": {
          "id": {"type": "string", "format": "uuid", "description": "UUID v4", "example": "f5c0d3a8-3a92-4b1d-9a8e-2e0a1b6c8d7e"},
          "exam": {"type": "string", "description": "시험명"},
          "date": {"type": "string", "format": "date", "description": "시험일"},
          "scope": {"type": "string", "description": "출제범위"},
          "target": {"type": "string", "description": "달성 목표"},
          "source": {"type": "string", "enum": ["voice", "manual"], "description": "입력 출처"},
          "transcript": {"type": "string", "nullable": true, "description": "원본 전사 텍스트"},
          "created_at": {"type": "string", "format": "date-time", "description": "생성 시각"},
          "updated_at": {"type": "string", "format": "date-time", "description": "최종 수정 시각"},
          "d_day": {"type": "integer", "readOnly": true, "description": "오늘 기준 남은 일수. 음수면 과거."}
        }
      },
      "AppError": {
        "type": "object",
        "title": "AppError",
        "description": "에러 응답 공통 형식",
        "required": ["detail", "code"],
        "properties": {
          "detail": {"type": "string", "description": "사용자에게 보여줄 메시지"},
          "code": {"type": "string", "description": "머신 판독용 코드", "enum": ["invalid_audio", "transcription_failed", "extraction_failed", "provider_not_configured", "unauthorized", "not_found", "invalid_request", "http_error", "jwt_secret_missing", "internal_error"]},
          "meta": {"type": "object", "additionalProperties": true, "description": "부가 정보 (디버깅·관측용)"}
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "description": "FastAPI 의 검증 실패 응답. `code` 는 항상 `invalid_request`.",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ValidationError"}
          },
          "code": {"type": "string", "default": "invalid_request"}
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "description": "Pydantic 의 개별 필드 오류",
        "required": ["loc", "msg", "type"],
        "properties": {
          "loc": {"type": "array", "items": {"type": "string"}, "description": "오류 발생 위치 경로", "example": ["body", "exam"]},
          "msg": {"type": "string", "description": "오류 메시지"},
          "type": {"type": "string", "description": "Pydantic 오류 타입", "example": "value_error.missing"},
          "input": {"description": "원본 입력값"},
          "ctx": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
